<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    android:background="@color/roxo">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Avaliação do Desgaste"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:paddingBottom="16dp"
        android:fontFamily="@font/roboto_bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quão cansado você se sente após o treino? (1 a 10)"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:paddingBottom="4dp"/>

    <!-- Barra deslizante -->
    <SeekBar
        android:id="@+id/seekBarDesgaste"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="10"
        android:progress="5"/>

    <TextView
        android:id="@+id/tvResultadoDesgaste"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecione uma nota"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:paddingTop="8dp"/>

    <!-- Botão de salvar -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSalvarAvaliacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_fundo2"
        android:text="Salvar Avaliação"
        android:textAlignment="center"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="@font/roboto_bold"/>
</LinearLayout>
