<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="@color/roxo"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="wrap_content"
        android:layout_height="250dp"
        android:src="@drawable/jogador1"
        android:contentDescription="Logo"
        android:layout_marginTop="35dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/fundo02">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cadastro"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="25dp"
            android:layout_marginTop="45dp"
            android:textSize="35sp"
            android:textColor="@color/roxo"
            android:fontFamily="@font/roboto_bold"
            android:textStyle="bold"
            android:textFontWeight="700"/>


        <EditText
            android:id="@+id/etNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"
            android:background="@drawable/bg_fundo3"
            android:hint="Nome"
            android:padding="12dp"
            android:textColor="@color/roxo"
            android:textColorHint="@color/roxo"
            android:fontFamily="@font/roboto_bold"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_fundo3"
            android:hint="E-mail"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:textColor="@color/roxo"
            android:textColorHint="@color/roxo"
            android:fontFamily="@font/roboto_bold" />

        <EditText
            android:id="@+id/etSenha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_fundo3"
            android:hint="Senha"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="@color/roxo"
            android:textColorHint="@color/roxo"
            android:fontFamily="@font/roboto_bold" />

        <EditText
            android:id="@+id/etConfirmarSenha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_fundo3"
            android:hint="Confirmar Senha"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="@color/roxo"
            android:textColorHint="@color/roxo"
            android:fontFamily="@font/roboto_bold"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_salvarCadastro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_fundo2"
            android:text="Salvar"
            android:textAlignment="center"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/roboto_bold"/>
    </LinearLayout>

</LinearLayout>
