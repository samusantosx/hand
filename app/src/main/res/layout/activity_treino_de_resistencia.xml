<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    android:id="@+id/main"
    android:background="@drawable/trave"
    tools:context=".TreinoDeResistencia">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Treino de Resistência"
        android:id="@+id/precisionValue"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:paddingBottom="16dp"
        android:shadowColor="#000"
        android:shadowDx="4"
        android:shadowDy="4"
        android:shadowRadius="6"/>

    <!-- Cronômetro -->
    <TextView
        android:id="@+id/tvTempoTreino"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tempo: 00:00"
        android:textSize="20sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:paddingBottom="16dp"
        android:shadowColor="#000"
        android:shadowDx="4"
        android:shadowDy="4"
        android:shadowRadius="6"/>

    <!-- Exibição de Gols por Minuto -->
    <TextView
        android:id="@+id/tvGolsPorMinuto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gols por Minuto: --"
        android:textSize="20sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:paddingBottom="16dp"
        android:shadowColor="#000"
        android:shadowDx="4"
        android:shadowDy="4"
        android:shadowRadius="6"/>

    <!-- Exibição de Desgaste -->
    <TextView
        android:id="@+id/tvDesgaste"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Desgaste: --%"
        android:textSize="20sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:paddingBottom="16dp"
        android:shadowColor="#000"
        android:shadowDx="4"
        android:shadowDy="4"
        android:shadowRadius="6"/>

    <FrameLayout
        android:layout_width="350dp"
        android:layout_height="300dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/travehandbol"
            android:scaleType="fitXY" />

        <com.Super.hande.GoalOverlayView
            android:id="@+id/goalOverlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnFinalizarTreino"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_fundo2"
        android:text="Finalizar Treino"
        android:textColor="@color/white"
        android:layout_marginLeft="25dp"
        android:layout_marginRight="25dp"
        android:layout_marginTop="15dp"
        android:textSize="18sp"
        android:textAlignment="center"
        android:textAllCaps="false"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnVoltar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_fundo2"
        android:text="Voltar ao Menu"
        android:textColor="@color/white"
        android:layout_marginLeft="25dp"
        android:layout_marginRight="25dp"
        android:layout_marginTop="15dp"
        android:textSize="18sp"
        android:textAlignment="center"
        android:textAllCaps="false"/>

</LinearLayout>
